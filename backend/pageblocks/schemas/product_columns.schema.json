{
  "key": "product_columns",
  "version": 2,
  "title": "Alt Ürün Sütunları",
  "description": "Footer üstünde 3 sütun küçük ürün listesi (Öne Çıkan / İndirimdeki / En Çok Beğenilen) + geniş ekranda tanıtım görseli (şablon v1.0 footer widget'ları; v2.0 Footer-top-widget). Bu blok varken footer'ın kendi ürün bandı gizlenir.",
  "category": "urun",
  "group": "C",
  "status": "ready",
  "template_refs": [
    "T1/inc/footer/footer-widgets.php",
    "T2/html/home/index.html#Footer-top-widget"
  ],
  "layout": "container",
  "singleton": false,
  "allowed_pages": [
    "home",
    "*"
  ],
  "variants": [],
  "tabs": [
    "İçerik",
    "Ürünler",
    "Görünüm",
    "Karusel",
    "Gelişmiş"
  ],
  "fields": [
    {
      "name": "columns",
      "type": "repeater",
      "label": "Sütunlar",
      "tab": "Ürünler",
      "min": 1,
      "max": 4,
      "item_noun": "Sütun",
      "item_label": "{{title}}",
      "help": "Şablon: Öne Çıkan Ürünler / İndirimdeki Ürünler / En Çok Beğenilenler, her biri 3 ürün.",
      "item_fields": [
        {
          "name": "title",
          "type": "text",
          "label": "Başlık",
          "max_length": 80
        },
        {
          "name": "link",
          "type": "link",
          "label": "Başlık bağlantısı (isteğe bağlı)"
        },
        {
          "name": "source",
          "type": "product_source",
          "label": "Ürün kaynağı",
          "allowed_kinds": [
            "manual",
            "category",
            "discounted",
            "newest",
            "best_sellers",
            "featured",
            "top_rated",
            "tag",
            "brand",
            "recently_viewed"
          ],
          "default_limit": 3,
          "max_limit": 8
        },
        {
          "name": "show_rating",
          "type": "bool",
          "label": "Yıldız puanını göster",
          "width": "half",
          "help": "Yalnız puanı olan ürünlerde görünür."
        },
        {
          "name": "show_old_price",
          "type": "bool",
          "label": "Eski (üstü çizili) fiyatı göster",
          "width": "half"
        }
      ],
      "item_default": {
        "title": "Yeni sütun",
        "link": {
          "kind": "none",
          "url": "",
          "new_tab": false
        },
        "source": {
          "kind": "featured",
          "product_ids": [],
          "category_ids": [],
          "include_children": true,
          "tag": "",
          "brand_ids": [],
          "limit": 3,
          "sort": "default",
          "exclude_out_of_stock": false,
          "exclude_ids": [],
          "fill_with": "none"
        },
        "show_rating": false,
        "show_old_price": true
      }
    },
    {
      "name": "promo",
      "type": "group",
      "label": "Tanıtım görseli (yalnız ≥1480 px geniş ekranda)",
      "tab": "İçerik",
      "collapsible": true,
      "fields": [
        {
          "name": "enabled",
          "type": "bool",
          "label": "Göster"
        },
        {
          "name": "image",
          "type": "image",
          "label": "Görsel",
          "recommended": [
            330,
            360
          ],
          "show_if": {
            "enabled": [
              true
            ]
          }
        },
        {
          "name": "link",
          "type": "link",
          "label": "Bağlantı",
          "show_if": {
            "enabled": [
              true
            ]
          }
        }
      ]
    },
    {
      "name": "card",
      "type": "select",
      "label": "Kart tipi",
      "tab": "Görünüm",
      "width": "half",
      "options": [
        {
          "value": "list_small",
          "label": "Küçük liste (75×75, şablon)"
        }
      ]
    },
    {
      "name": "min_screen",
      "type": "select",
      "label": "Görünür olduğu ekranlar",
      "tab": "Görünüm",
      "width": "half",
      "options": [
        {
          "value": "lg",
          "label": "Yalnız ≥992 px (şablon)"
        },
        {
          "value": "all",
          "label": "Tüm ekranlar"
        }
      ],
      "help": "Şablonda bu bant tablet/mobilde gizlidir."
    }
  ],
  "common": [
    "section",
    "visibility",
    "reveal"
  ]
}
