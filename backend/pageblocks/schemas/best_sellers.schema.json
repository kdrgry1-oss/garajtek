{
  "key": "best_sellers",
  "version": 2,
  "title": "Ürün Kartları Karuseli (Çok Satanlar)",
  "description": "Başlık + kategori hapları + 2 satırlı yatay kart karuseli (şablon: best-sellers-products-cards-carousel)",
  "category": "urun",
  "group": "C",
  "status": "ready",
  "template_refs": [
    "T1/inc/blocks/homepage/best-sellers-products-cards-carousel.php"
  ],
  "layout": "container",
  "singleton": false,
  "allowed_pages": [
    "home",
    "*"
  ],
  "variants": [],
  "tabs": [
    "İçerik",
    "Ürünler",
    "Görünüm",
    "Karusel",
    "Gelişmiş"
  ],
  "fields": [
    {
      "name": "header",
      "type": "section_header",
      "label": "Başlık satırı",
      "tab": "İçerik"
    },
    {
      "name": "pills_auto_categories",
      "type": "group",
      "label": "Kök kategorilerden otomatik haplar",
      "tab": "İçerik",
      "fields": [
        {
          "name": "enabled",
          "type": "bool",
          "label": "Açık",
          "width": "half"
        },
        {
          "name": "max",
          "type": "number",
          "label": "En fazla",
          "min": 0,
          "max": 8,
          "width": "half"
        }
      ]
    },
    {
      "name": "pills_as_tabs",
      "type": "bool",
      "label": "Haplar ürünleri değiştirsin (sekme gibi)",
      "tab": "İçerik"
    },
    {
      "name": "source",
      "type": "product_source",
      "label": "Ürün kaynağı",
      "tab": "Ürünler",
      "allowed_kinds": [
        "manual",
        "category",
        "discounted",
        "newest",
        "best_sellers",
        "featured",
        "top_rated",
        "tag",
        "brand",
        "recently_viewed"
      ],
      "default_limit": 12
    },
    {
      "name": "columns",
      "type": "select",
      "label": "Sütun",
      "tab": "Görünüm",
      "width": "third",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "name": "rows_per_slide",
      "type": "number",
      "label": "Satır / sayfa",
      "tab": "Görünüm",
      "width": "third",
      "min": 1,
      "max": 3
    },
    {
      "name": "card",
      "type": "select",
      "label": "Kart tipi",
      "tab": "Görünüm",
      "width": "third",
      "options": [
        {
          "value": "horizontal",
          "label": "Yatay kart"
        },
        {
          "value": "grid",
          "label": "Izgara kartı"
        }
      ]
    },
    {
      "name": "carousel",
      "type": "carousel",
      "label": "Karusel",
      "tab": "Karusel",
      "hide": [
        "per_view",
        "rows"
      ]
    },
    {
      "name": "empty_text",
      "type": "text",
      "label": "Boş durum yazısı",
      "tab": "Gelişmiş"
    }
  ],
  "common": [
    "section",
    "visibility",
    "reveal"
  ]
}
