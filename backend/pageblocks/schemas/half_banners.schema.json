{
  "key": "half_banners",
  "version": 2,
  "title": "İki Banner (eski)",
  "description": "Yan yana iki (en fazla dört) görsel banner — eski blok, şemaya taşındı",
  "category": "banner",
  "group": "A",
  "status": "ready",
  "template_refs": [
    "T1/inc/blocks/homepage/home-banner.php"
  ],
  "layout": "container",
  "singleton": false,
  "allowed_pages": [
    "home",
    "*"
  ],
  "variants": [],
  "tabs": [
    "İçerik",
    "Ürünler",
    "Görünüm",
    "Karusel",
    "Gelişmiş"
  ],
  "fields": [
    {
      "name": "items",
      "type": "repeater",
      "label": "Bannerlar",
      "tab": "İçerik",
      "max": 4,
      "item_label": "{{alt}}",
      "item_noun": "Banner",
      "item_fields": [
        {
          "name": "image",
          "type": "image",
          "label": "Görsel",
          "recommended": [
            570,
            300
          ],
          "allow_mobile": true
        },
        {
          "name": "link",
          "type": "link",
          "label": "Bağlantı",
          "kinds": [
            "category",
            "product",
            "page",
            "brand",
            "search",
            "url",
            "none"
          ]
        },
        {
          "name": "alt",
          "type": "text",
          "label": "Alternatif metin"
        }
      ],
      "item_default": {
        "image": null,
        "link": {
          "kind": "url",
          "url": "/sale",
          "new_tab": false
        },
        "alt": ""
      }
    },
    {
      "name": "gap",
      "type": "number",
      "label": "Bannerlar arası boşluk",
      "tab": "Görünüm",
      "unit": "px",
      "min": 0,
      "max": 80,
      "width": "half"
    },
    {
      "name": "radius",
      "type": "number",
      "label": "Köşe yuvarlaklığı",
      "tab": "Görünüm",
      "unit": "px",
      "min": 0,
      "max": 40,
      "width": "half"
    }
  ],
  "common": [
    "section",
    "visibility",
    "reveal"
  ],
  "legacy": true
}
