{
  "key": "product_slider",
  "version": 2,
  "title": "Ürün Karuseli",
  "description": "Başlık (sağda ‹ › okları) + 6'lı küçük ürün kartı karuseli; Yeni Eklenenler, kategori, trend vb. (şablon v1.0 recently-added-products-carousel; v2.0 Recently Viewed)",
  "category": "urun",
  "group": "C",
  "status": "ready",
  "template_refs": [
    "T1/inc/blocks/homepage/recently-added-products-carousel.php",
    "T1/inc/blocks/homepage/home-v2-categories-products-carousel.php",
    "T1/assets/sass/blocks/_products-carousel.scss",
    "T2/html/home/index.html#Recently-viewed"
  ],
  "layout": "container",
  "singleton": false,
  "allowed_pages": [
    "home",
    "*"
  ],
  "variants": [
    {
      "value": "v1",
      "label": "v1 – Yeni Eklenenler (6'lı, varsayılan)",
      "defaults_patch": {}
    },
    {
      "value": "v2_wide",
      "label": "v2.0 – geniş ekranda 7'li, mobilde 2'li (Recently Viewed düzeni)",
      "defaults_patch": {
        "header": {
          "title": "Öne Çıkan Ürünler"
        },
        "source": {
          "kind": "featured",
          "limit": 14,
          "fill_with": "newest"
        },
        "carousel": {
          "per_view": {
            "0": 2,
            "480": 2,
            "768": 3,
            "992": 4,
            "1200": 6,
            "1480": 7
          }
        }
      }
    },
    {
      "value": "category",
      "label": "Kategori ürünleri (v1.0 home-v2, 4'lü)",
      "defaults_patch": {
        "header": {
          "title": "Kategori Ürünleri"
        },
        "source": {
          "kind": "category",
          "limit": 12,
          "fill_with": "newest"
        },
        "card": "grid",
        "carousel": {
          "per_view": {
            "0": 1,
            "480": 2,
            "768": 2,
            "992": 3,
            "1200": 4,
            "1480": 4
          }
        }
      }
    }
  ],
  "tabs": [
    "İçerik",
    "Ürünler",
    "Görünüm",
    "Karusel",
    "Gelişmiş"
  ],
  "fields": [
    {
      "name": "header",
      "type": "section_header",
      "label": "Başlık satırı",
      "tab": "İçerik",
      "help": "Şablonda başlığın sağında ‹ › okları vardır (Sağ taraf: Oklar). Karusel sekmesinde Oklar = Başlıkta olmalı.",
      "right_options": [
        "none",
        "arrows",
        "pills",
        "link"
      ]
    },
    {
      "name": "source",
      "type": "product_source",
      "label": "Ürün kaynağı",
      "tab": "Ürünler",
      "allowed_kinds": [
        "manual",
        "category",
        "discounted",
        "newest",
        "best_sellers",
        "featured",
        "top_rated",
        "tag",
        "brand",
        "recently_viewed"
      ],
      "default_limit": 14,
      "help": "Şablon: en yeni ürünler. Kategori, indirimdekiler, çok satanlar, elle seçim vb. seçilebilir."
    },
    {
      "name": "card",
      "type": "select",
      "label": "Kart tipi",
      "tab": "Görünüm",
      "width": "half",
      "options": [
        {
          "value": "grid_small",
          "label": "Küçük ızgara kartı (şablon, 6'lı)"
        },
        {
          "value": "grid",
          "label": "Izgara kartı"
        },
        {
          "value": "horizontal",
          "label": "Yatay kart"
        }
      ]
    },
    {
      "name": "show_discount_badge",
      "type": "bool",
      "label": "İndirim rozetini göster",
      "tab": "Görünüm",
      "width": "half",
      "help": "Açıkken bu karuseldeki kartlarda “-%25” rozeti görünür; kapalıyken gizlenir (genel kart ayarından bağımsız)."
    },
    {
      "name": "carousel",
      "type": "carousel",
      "label": "Karusel",
      "tab": "Karusel",
      "help": "Şablon: 0 px 1, 480 px 2, 768 px 2, 992 px 3, 1200 px 6 ürün; başlıkta oklar, altta noktalar, görünen son kartın ayırıcısı gizli."
    }
  ],
  "common": [
    "section",
    "visibility",
    "reveal"
  ]
}
