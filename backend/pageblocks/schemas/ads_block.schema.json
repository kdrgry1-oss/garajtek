  ],
  "fields": [
    {
      "name": "items",
      "type": "repeater",
      "label": "Kutular",
      "tab": "İçerik",
      "min": 1,
      "max": 4,
      "item_label": "{{text}}",
      "item_noun": "Kutu",
      "item_fields": [
        {
          "name": "image",
          "type": "image",
          "label": "Görsel",
          "recommended": [
            410,
            281
          ],
          "help": "Şablon: 1. ve 2. kutu 410×281, 3. kutu 714×486 (v2.0 kartlar 190×150). Görsel sol %60'lık alanı doldurur."
        },
        {
          "name": "text",
          "type": "rich_text",
          "label": "Metin",
          "marks": [
            "strong",
            "br"
          ],
          "max_length": 200,
          "help": "Büyük harfe çevrilir. Vurgulamak istediğiniz kelimeyi kalın (K) yapın, satır için ↵."
        },
        {
          "name": "action_type",
          "type": "select",
          "label": "Alt satır",
          "width": "half",
          "options": [
            {
              "value": "link",
              "label": "Bağlantı yazısı (Hemen İncele ›)"
            },
            {
              "value": "upto",
              "label": "'%'ye varan' + büyük sayı"
            },
            {
              "value": "from_price",
              "label": "'başlayan' + fiyat"
            },
            {
              "value": "none",
              "label": "Gösterme"
            }
          ]
        },
        {
          "name": "action_text",
          "type": "text",
          "label": "Bağlantı yazısı",
          "width": "half",
          "show_if": {
            "action_type": [
              "link"
            ]
          }
        },
        {
          "name": "action_prefix",
          "type": "text",
          "label": "Ön yazı",
          "width": "third",
          "show_if": {
            "action_type": [
              "upto",
              "from_price"
            ]
          },
          "help": "Sayının solunda iki satır küçük yazı (şablon: UP TO / FROM)."
        },
        {
          "name": "action_value",
          "type": "text",
          "label": "Sayı / fiyat",
          "width": "third",
          "show_if": {
            "action_type": [
              "upto",
              "from_price"
            ]
          }
        },
        {
          "name": "action_suffix",
          "type": "text",
          "label": "Son ek",
          "width": "third",
          "show_if": {
            "action_type": [
              "upto",
              "from_price"
            ]
          },
          "help": "Sayının sağ üstünde küçük yazı (ör. kuruş ,99 veya %)."
        },
        {
          "name": "currency",
          "type": "text",
          "label": "Para birimi",
          "width": "half",
          "show_if": {
            "action_type": [
              "from_price"
            ]
          }
        },
        {
          "name": "link",
          "type": "link",
          "label": "Bağlantı",
          "kinds": [
            "category",
            "product",
            "page",
            "brand",
            "search",
            "url",
            "none"
          ]
        },
        {
          "name": "image_rotation",
          "type": "number",
          "label": "Görsel döndürme",
          "unit": "derece",
          "min": -45,
          "max": 45,
          "width": "half",
          "help": "v2.0 v8 geniş kutudaki eğik ürün görseli için (ör. 25)."
        }
      ],
      "item_default": {
        "image": null,
        "text": "Yeni <strong>kampanya</strong>",
        "action_type": "link",
        "action_text": "Hemen İncele",
        "action_prefix": "",
        "action_value": "",
        "action_suffix": "",
        "currency": "₺",
        "link": {
          "kind": "url",
          "url": "/sale",
          "new_tab": false
        },
        "image_rotation": 0
      }
    },
    {
      "name": "columns",
      "type": "select",
      "label": "Sütun sayısı",
      "tab": "Görünüm",
      "width": "third",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "name": "ratio",
      "type": "select",
      "label": "Görsel / metin oranı",
      "tab": "Görünüm",
      "width": "third",
      "options": [
        {
          "value": "60_40",
          "label": "%60 / %40 (şablon v1–v2)"
        },
        {
          "value": "62_38",
          "label": "%62 / %38 (şablon v3)"
        },
        {
          "value": "50_50",
          "label": "%50 / %50"
        }
      ]
    },
    {
      "name": "text_size",
      "type": "number",
      "label": "Metin boyutu",
      "tab": "Görünüm",
      "unit": "em",
      "min": 0.8,
      "max": 3,
      "step": 0.001,
      "width": "third",
      "help": "Şablon v1: 1.286 em (18 px), v2/v3: 1.571 em."
    },
    {
      "name": "letter_spacing",
      "type": "number",
      "label": "Harf aralığı",
      "tab": "Görünüm",
      "unit": "px",
      "min": -3,
      "max": 3,
      "step": 0.1,
      "width": "third"
    },
    {
      "name": "card_background",
      "type": "color",
      "label": "Kutu arka planı",
      "tab": "Görünüm",
      "palette": "theme",
      "width": "third",
      "allow_transparent": true
    },
    {
      "name": "text_color",
      "type": "color",
      "label": "Yazı rengi",
      "tab": "Görünüm",
      "palette": "theme",
      "width": "third"
    },
    {
      "name": "arrow_color",
      "type": "color",
      "label": "Ok yuvarlağı rengi",
      "tab": "Görünüm",
      "palette": "theme",
      "width": "third",
      "help": "Boş = tema ana rengi."
    },
    {
      "name": "body_padding",
      "type": "group",
      "label": "Metin alanı boşluğu",
      "tab": "Görünüm",
      "collapsible": true,
      "fields": [
        {
          "name": "top",
          "type": "number",
          "label": "Üst",
          "unit": "em",
          "min": 0,
          "max": 6,
          "step": 0.001,
          "width": "half"
        },
        {
          "name": "bottom",
          "type": "number",
          "label": "Alt",
          "unit": "em",
          "min": 0,
          "max": 6,
          "step": 0.001,
          "width": "half"
        }
      ]
    },
    {
      "name": "gap_mobile",
      "type": "number",
      "label": "Mobilde kutular arası",
      "tab": "Görünüm",
      "unit": "px",
      "min": 0,
      "max": 80
    }
  ],
  "common": [
    "section",
    "visibility",
    "reveal"
  ]
}
