{
  "version": 1,
  "_note": "Ürün kartı 'Teknik Özellikler' alan tanımları ve kategori → şablon eşlemesi. Panelden (Katalog → Ürün Özellikleri → Teknik Özellik Şablonları uç noktası) değiştirilebilir; değişiklik settings.spec_templates kaydına yazılır, bu dosya varsayılandır. Kaynak: grayzer.net ve algikitelli.com.tr ürün sayfalarında listelenen özellikler (kapasite, kaldırma yüksekliği, motor gücü, voltaj, tank hacmi, basınç, jant çapı aralığı, parça sayısı vb.).",
  "groups": [
    {"key": "genel", "label": "Genel Bilgiler"},
    {"key": "performans", "label": "Kapasite & Performans"},
    {"key": "guc", "label": "Güç & Elektrik"},
    {"key": "el_aleti", "label": "El Aleti & Set Özellikleri"},
    {"key": "olcum", "label": "Ölçüm & Bağlantı"},
    {"key": "boyut", "label": "Boyut & Ağırlık"},
    {"key": "teslimat", "label": "Teslimat, Kurulum & Servis"}
  ],
  "fields": [
    {"key": "model", "label": "Model / Seri", "group": "genel", "type": "text"},
    {"key": "mpn", "label": "Üretici Parça No (MPN)", "group": "genel", "type": "text"},
    {"key": "origin_country", "label": "Menşei (Ülke)", "group": "genel", "type": "select", "free": true,
     "options": ["Türkiye", "Çin", "İtalya", "Almanya", "Tayvan", "ABD", "Japonya", "Kore", "İspanya", "Fransa"]},
    {"key": "warranty_months", "label": "Garanti Süresi", "group": "genel", "type": "int", "unit": "ay", "min": 0, "max": 240},
    {"key": "certifications", "label": "Sertifikalar", "group": "genel", "type": "multiselect", "free": true,
     "options": ["CE", "TSE", "ISO 9001", "GS", "TÜV", "EAC", "RoHS"]},
    {"key": "usage_area", "label": "Kullanım Alanı", "group": "genel", "type": "text"},

    {"key": "lifting_capacity_kg", "label": "Kaldırma / Taşıma Kapasitesi", "group": "performans", "type": "number", "unit": "kg", "min": 0, "max": 100000, "filter": true},
    {"key": "lift_height_mm", "label": "Maks. Kaldırma Yüksekliği", "group": "performans", "type": "number", "unit": "mm", "min": 0, "max": 10000},
    {"key": "min_height_mm", "label": "Min. Yükseklik", "group": "performans", "type": "number", "unit": "mm", "min": 0, "max": 5000},
    {"key": "lift_time_s", "label": "Kaldırma / İndirme Süresi", "group": "performans", "type": "text", "placeholder": "60 / 40 sn"},
    {"key": "working_pressure_bar", "label": "Çalışma Basıncı", "group": "performans", "type": "number", "unit": "bar", "min": 0, "max": 1000, "filter": true},
    {"key": "tank_volume_l", "label": "Tank Hacmi", "group": "performans", "type": "number", "unit": "lt", "min": 0, "max": 10000, "filter": true},
    {"key": "air_flow_lpm", "label": "Hava Debisi", "group": "performans", "type": "number", "unit": "lt/dk", "min": 0, "max": 100000},
    {"key": "air_consumption_lpm", "label": "Hava Tüketimi", "group": "performans", "type": "number", "unit": "lt/dk", "min": 0, "max": 10000},
    {"key": "rim_diameter_in", "label": "Jant Çapı Aralığı", "group": "performans", "type": "text", "unit": "inç", "placeholder": "10–24"},
    {"key": "rpm", "label": "Devir", "group": "performans", "type": "number", "unit": "dev/dk", "min": 0, "max": 100000},
    {"key": "torque_nm", "label": "Maks. Tork", "group": "performans", "type": "number", "unit": "Nm", "min": 0, "max": 20000},
    {"key": "noise_db", "label": "Gürültü Seviyesi", "group": "performans", "type": "number", "unit": "dB", "min": 0, "max": 200},

    {"key": "power_source", "label": "Güç Kaynağı", "group": "guc", "type": "select", "filter": true,
     "options": ["Elektrik", "Akülü", "Havalı", "Hidrolik", "Elektro-Hidrolik", "Manuel", "Benzinli"]},
    {"key": "voltage", "label": "Voltaj", "group": "guc", "type": "select", "free": true, "filter": true,
     "options": ["12 V", "24 V", "220 V", "380 V", "220 / 380 V"]},
    {"key": "phase", "label": "Faz", "group": "guc", "type": "select", "filter": true, "options": ["Monofaze", "Trifaze"]},
    {"key": "frequency_hz", "label": "Frekans", "group": "guc", "type": "number", "unit": "Hz", "min": 0, "max": 1000},
    {"key": "motor_power_kw", "label": "Motor Gücü", "group": "guc", "type": "number", "unit": "kW", "min": 0, "max": 1000},
    {"key": "motor_power_hp", "label": "Motor Gücü (HP)", "group": "guc", "type": "number", "unit": "HP", "min": 0, "max": 1500},
    {"key": "battery_voltage_v", "label": "Akü Voltajı", "group": "guc", "type": "number", "unit": "V", "min": 0, "max": 1000},
    {"key": "battery_capacity_ah", "label": "Akü Kapasitesi", "group": "guc", "type": "number", "unit": "Ah", "min": 0, "max": 1000},

    {"key": "drive_size", "label": "Lokma Ölçüsü / Sürücü", "group": "el_aleti", "type": "multiselect", "filter": true,
     "options": ["1/4\"", "3/8\"", "1/2\"", "3/4\"", "1\""]},
    {"key": "piece_count", "label": "Parça Sayısı", "group": "el_aleti", "type": "int", "unit": "parça", "min": 0, "max": 5000},
    {"key": "drawer_count", "label": "Çekmece Sayısı", "group": "el_aleti", "type": "int", "unit": "adet", "min": 0, "max": 100},
    {"key": "material", "label": "Malzeme", "group": "el_aleti", "type": "select", "free": true,
     "options": ["Krom-Vanadyum (Cr-V)", "Krom-Molibden (Cr-Mo)", "S2 Çelik", "Karbon Çelik", "Paslanmaz Çelik", "Alüminyum", "DKP Sac", "Döküm"]},

    {"key": "measurement_range", "label": "Ölçüm Aralığı", "group": "olcum", "type": "text"},
    {"key": "display_type", "label": "Ekran Tipi", "group": "olcum", "type": "select", "free": true,
     "options": ["Dijital LED", "LCD", "Dokunmatik", "Analog", "Yok"]},
    {"key": "connectivity", "label": "Bağlantı", "group": "olcum", "type": "multiselect", "free": true,
     "options": ["OBD2", "Bluetooth", "Wi-Fi", "USB", "Kablolu"]},

    {"key": "product_dimensions", "label": "Ürün Boyutları (En × Boy × Yükseklik)", "group": "boyut", "type": "dimensions", "unit": "cm"},
    {"key": "net_weight_kg", "label": "Net Ağırlık", "group": "boyut", "type": "number", "unit": "kg", "min": 0, "max": 100000},

    {"key": "installation_included", "label": "Kurulum Dahil", "group": "teslimat", "type": "bool"},
    {"key": "assembly_service", "label": "Montaj Hizmeti", "group": "teslimat", "type": "select",
     "options": ["Yok", "Ücretsiz", "Ücretli", "Bölgeye göre"]},
    {"key": "spare_parts_support", "label": "Yedek Parça / Servis Desteği", "group": "teslimat", "type": "select", "free": true,
     "options": ["Var", "Yok", "10 yıl yedek parça garantisi"]},
    {"key": "box_contents", "label": "Kutu İçeriği", "group": "teslimat", "type": "textarea"}
  ],
  "common_fields": ["model", "mpn", "origin_country", "warranty_months", "certifications", "usage_area",
                    "product_dimensions", "net_weight_kg",
                    "installation_included", "assembly_service", "spare_parts_support", "box_contents"],
  "templates": [
    {"key": "lift", "label": "Liftler", "category_slugs": ["liftler"],
     "fields": ["lifting_capacity_kg", "lift_height_mm", "min_height_mm", "lift_time_s", "power_source", "voltage", "phase", "motor_power_kw", "working_pressure_bar", "noise_db"]},
    {"key": "compressor", "label": "Kompresörler", "category_slugs": ["kompresorler"],
     "fields": ["tank_volume_l", "working_pressure_bar", "air_flow_lpm", "motor_power_kw", "motor_power_hp", "rpm", "voltage", "phase", "power_source", "noise_db"]},
    {"key": "air_tools", "label": "Havalı Aletler", "category_slugs": ["havali-aletler"],
     "fields": ["drive_size", "torque_nm", "rpm", "working_pressure_bar", "air_consumption_lpm", "power_source", "noise_db", "material"]},
    {"key": "tire", "label": "Lastik Ekipmanları", "category_slugs": ["lastik-ekipmanlari"],
     "fields": ["rim_diameter_in", "working_pressure_bar", "motor_power_kw", "voltage", "phase", "power_source", "rpm", "display_type", "measurement_range"]},
    {"key": "lifting", "label": "Kaldırma Ekipmanları (kriko, vinç, pres)", "category_slugs": ["kaldirma-ekipmanlari"],
     "fields": ["lifting_capacity_kg", "lift_height_mm", "min_height_mm", "power_source", "working_pressure_bar", "material"]},
    {"key": "tool_cart", "label": "Takım Arabaları ve Tezgahlar", "category_slugs": ["takim-arabalari-ve-tezgahlar"],
     "fields": ["drawer_count", "piece_count", "lifting_capacity_kg", "material", "drive_size"]},
    {"key": "socket", "label": "Lokma Takımları", "category_slugs": ["lokma-takimlari"],
     "fields": ["drive_size", "piece_count", "material", "measurement_range"]},
    {"key": "hand_tools", "label": "El Aletleri", "category_slugs": ["el-aletleri"],
     "fields": ["drive_size", "piece_count", "material", "torque_nm", "measurement_range"]},
    {"key": "cordless", "label": "Elektrikli ve Şarjlı El Aletleri", "category_slugs": ["elektrikli-ve-sarjli-el-aletleri"],
     "fields": ["power_source", "battery_voltage_v", "battery_capacity_ah", "motor_power_kw", "rpm", "torque_nm", "drive_size", "voltage", "noise_db"]},
    {"key": "welding", "label": "Kaynak, Kesme ve Aydınlatma", "category_slugs": ["kaynak-kesme-ve-aydinlatma"],
     "fields": ["voltage", "phase", "frequency_hz", "motor_power_kw", "measurement_range", "display_type", "power_source", "battery_capacity_ah"]},
    {"key": "diagnostic", "label": "Test ve Arıza Tespit Cihazları", "category_slugs": ["test-ve-ariza-tespit-cihazlari"],
     "fields": ["measurement_range", "display_type", "connectivity", "voltage", "battery_voltage_v", "power_source"]},
    {"key": "lubrication", "label": "Yağlama Ekipmanları", "category_slugs": ["yaglama-ekipmanlari"],
     "fields": ["tank_volume_l", "working_pressure_bar", "power_source", "air_consumption_lpm", "air_flow_lpm"]},
    {"key": "service", "label": "Oto Servis Ekipmanları", "category_slugs": ["oto-servis-ekipmanlari", "ozel-aparatlar"],
     "fields": ["power_source", "voltage", "working_pressure_bar", "tank_volume_l", "lifting_capacity_kg", "measurement_range", "display_type", "material", "piece_count"]},
    {"key": "package", "label": "Servis Kurulum Paketleri", "category_slugs": ["servis-kurulum-paketleri"],
     "fields": ["piece_count", "voltage", "phase", "power_source"]}
  ]
}
