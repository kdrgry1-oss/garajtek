# ——— ZORUNLU ———
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=yenimarka
JWT_SECRET=                      # openssl rand -hex 32
CORS_ORIGINS=https://yenimarka.com,https://www.yenimarka.com
BACKEND_URL=https://api.yenimarka.com
FRONTEND_URL=https://yenimarka.com
ADMIN_INITIAL_EMAIL=             # ilk yönetici e-postası (boşsa ilk admin OLUŞTURULMAZ)
ADMIN_INITIAL_PASSWORD=          # en az 12 karakter; ilk girişten sonra değiştirin
SITE_URL=https://yenimarka.com   # e-posta linkleri / feed / CAPI (Firma Bilgileri boşsa)
PUBLIC_API_URL=https://api.yenimarka.com
SITE_NAME=Yeni Marka             # uyarı konu öneki / CAPI marka yedeği

# ——— DESTEK / GÜVENLİK ———
SUPPORT_AUDIT_KEY=               # boşsa /api/health?diag=1 destek teşhisleri KAPALI
CF_EDGE_SECRET=                  # Cloudflare Transform Rule gizli değeri (opsiyonel)
CF_EDGE_HEADER=x-edge-secret     # CF'nin eklediği header adı
ALERT_TO_EMAIL=                  # güvenlik/izleme uyarı alıcısı (boşsa e-posta gönderilmez)
JWT_ISSUER=store-api

# ——— ÖDEME (iyzico) ———
IYZICO_API_KEY=
IYZICO_SECRET=
IYZICO_BASE_URL=https://api.iyzipay.com

# ——— GÖRSEL DEPOSU (Cloudflare R2) ———
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CDN_URL=https://cdn.yenimarka.com

# ——— E-POSTA ———
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ——— OPSİYONEL (firma-özel; koda gömülü varsayılan YOK) ———
RETURN_CONTRACT_NO=              # anlaşmalı kargo iade sözleşme no (panelden de girilebilir)
TICIMAX_DOMAIN=                  # yalnız Ticimax'tan geçişte
TICIMAX_API_KEY=
PRODUCT_XML_FEED_URL=            # XML ürün içe aktarımı (boşsa kapalı)
DOGAN_APPLICATION_NAME=ECOMMERCE

# ——— KULLANILMAYACAKLAR (boş bırakın; boşsa ilgili işler çalışmaz) ———
# TRENDYOL_*, HEPSIBURADA_*, AMAZON_*, TEMU_*  → pazaryeri yok
# NETGSM_*                                     → SMS/İYS yok
