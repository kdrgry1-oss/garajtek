# =============================================================================
# garajtek.com — üretim ortam değişkenleri  →  /opt/garajtek/backend/.env
# =============================================================================
# install.sh bu dosyayı kopyalar ve __...__ ile işaretli gizli değerleri OTOMATİK üretir
# (JWT_SECRET, SECRETS_MASTER_KEY, CF_EDGE_SECRET, ADMIN_INITIAL_PASSWORD).
# Değiştirdikten sonra:  systemctl restart garajtek-api
#
# KURAL: yorumlar AYRI satırda olmalı. "ANAHTAR=değer   # yorum" YAZMAYIN — systemd
# (EnvironmentFile) satır içi yorumu değerin parçası sayar.
# Dosya izni 600 olmalıdır (yalnız garajtek kullanıcısı + root okur).
# =============================================================================

# ——— VERİTABANI (gömülü SQLite — ayrı veritabanı sunucusu YOK) ———
# Uygulama TEK işçi (uvicorn --workers 1) ile çalışmalıdır.
DB_PATH=/opt/garajtek/data/store.db

# ——— ADRESLER ———
# Seçenek A (önerilen): mağaza + API aynı alan adında (https://garajtek.com/api/...).
# Seçenek B (frontend Cloudflare Pages'te): PUBLIC_API_URL=https://api.garajtek.com
SITE_URL=https://garajtek.com
FRONTEND_URL=https://garajtek.com
PUBLIC_API_URL=https://garajtek.com
BACKEND_URL=https://garajtek.com
CORS_ORIGINS=https://garajtek.com,https://www.garajtek.com
SITE_NAME=Garajtek

# ——— GÜVENLİK (install.sh otomatik üretir; kurulumdan sonra DEĞİŞTİRMEYİN) ———
# JWT_SECRET: openssl rand -hex 32  (değişirse tüm oturumlar düşer)
JWT_SECRET=__JWT_SECRET__
# SECRETS_MASTER_KEY: panelden girilen entegrasyon şifrelerini (iyzico, kargo, SMTP...) şifreler.
# KAYBEDERSENİZ o şifreler çözülemez → yedekte .env de saklanır. Değiştirmeyin.
SECRETS_MASTER_KEY=__SECRETS_MASTER_KEY__
JWT_ISSUER=garajtek-api

# ——— İLK YÖNETİCİ ———
# ADMIN_INITIAL_EMAIL kalıcı süper yöneticidir (silmeyin). Parola ilk girişte değiştirilir;
# değiştirdikten sonra ADMIN_INITIAL_PASSWORD satırını boşaltın.
ADMIN_INITIAL_EMAIL=__ADMIN_EMAIL__
ADMIN_INITIAL_PASSWORD=__ADMIN_PASSWORD__
OWNER_SUPER_ADMIN_EMAILS=__ADMIN_EMAIL__
# 1 → yöneticilere iki adımlı doğrulama (MFA) zorunlu. Doğrulama kodu e-postayla gider:
# mail gönderimi (Ayarlar › Bildirimler veya deploy/mail) çalışana kadar "off" bırakın,
# yoksa panele giremezsiniz. Mail çalışınca 1 yapıp: systemctl restart garajtek-api
ADMIN_MFA_ENFORCE=off
MFA_ISSUER_NAME=Garajtek

# ——— CLOUDFLARE ———
# Cloudflare Transform Rule her isteğe "X-Edge-Secret: <bu değer>" başlığını ekler;
# backend böylece CF-Connecting-IP'ye güvenir (KURULUM.md §3.5). Boşsa kontrol kapalıdır.
CF_EDGE_SECRET=__CF_EDGE_SECRET__
CF_EDGE_HEADER=x-edge-secret

# ——— GÖRSELLER / MEDYA ———
# Varsayılan: sunucu diski. Yüklenen görseller MEDIA_DIR'e yazılır, nginx /media/ altında
# servis eder, Cloudflare önbelleğe alır. MEDIA_PUBLIC_URL boşsa SITE_URL + /media kullanılır.
# Seçenek B'de (frontend Pages'te) MEDIA_PUBLIC_URL=https://api.garajtek.com/media yazın.
MEDIA_DIR=/opt/garajtek/media
MEDIA_PUBLIC_URL=
# İsteğe bağlı Cloudflare R2: AŞAĞIDAKİLERİN HEPSİ doluysa yeni yüklemeler R2'ye gider
# (R2_PUBLIC_URL = bucket'a bağlı public alan adı, ör. https://cdn.garajtek.com).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
CDN_URL=

# ——— YEDEK (deploy/backup.sh) ———
# Gece 03:30 yedeği /var/backups/garajtek altında 7 gün tutulur. Sunucu DIŞINA da kopyalamak
# için (şiddetle önerilir) ÖZEL (public olmayan) bir R2 bucket'ı tanımlayın.
# BACKUP_R2_ENDPOINT boşsa R2_ENDPOINT / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY kullanılır.
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Doluysa sunucu dışına giden yedek AES-256 ile şifrelenir (parolayı ayrıca saklayın!).
BACKUP_PASSPHRASE=
BACKUP_KEEP=7

# ——— SİSTEM UYARI E-POSTASI (opsiyonel) ———
# Müşteri e-postaları (sipariş vb.) panelden ayarlanır: Ayarlar › Bildirimler.
ALERT_TO_EMAIL=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SUBJECT_PREFIX=[garajtek]

# ——— ÖDEME (iyzico) — panelden de girilebilir ———
# IYZICO_MODE: sandbox (test) | live
IYZICO_MODE=sandbox
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# ——— GOOGLE İLE GİRİŞ (opsiyonel) ———
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Boşsa istek adresinden türetilir (https://<alan>/api/auth/google/callback).
GOOGLE_REDIRECT_URI=

# ——— DESTEK / TEŞHİS ———
# Boşsa /api/health?diag=1 destek teşhisleri KAPALI. /docs canlıda kapalı kalsın (0).
SUPPORT_AUDIT_KEY=
ENABLE_API_DOCS=0
ENVIRONMENT=production

# ——— KULLANILMAYANLAR (boş bırakın; boşsa ilgili işler çalışmaz) ———
# NETGSM_*                                     → SMS/İYS yok
# MONGO_URL / DB_NAME                          → kullanılmıyor (SQLite: DB_PATH)
