    print("ACIK" if ok else "KAPALI", detail)
    return None


def cmd_dns_check(args):
    dom, host = CONF["DOMAIN"], CONF["HOST"]
    ip = public_ip()
    exp = expected_records(ip)
    checks = []

    def add(key, label, status, found, message=""):
        checks.append({"key": key, "label": label, "status": status, "found": found,
                       "expected": exp.get(key), "message": message})

    a = dig(host, "A")
    add("a", "A kaydı (%s)" % host, "pass" if ip and ip in a else "fail", a,
        "" if ip in a else "mail alt alan adı sunucu IP'sine gitmeli (Cloudflare'de gri bulut).")

    mx = dig(dom, "MX")
    mx_hosts = [m.split()[-1].rstrip(".").lower() for m in mx if m.split()]
    add("mx", "MX kaydı", "pass" if host in mx_hosts else "fail", mx,
        "" if host in mx_hosts else "MX @ → %s (öncelik 10) olmalı." % host)

    txt = dig(dom, "TXT")
    spf = [t for t in txt if t.lower().startswith("v=spf1")]
    if len(spf) == 1 and (("ip4:" + ip) in spf[0] or re.search(r"(^|\s)[+]?mx(\s|$)", spf[0])):
        st, msg = "pass", ""
    elif len(spf) > 1:
        st, msg = "fail", "Birden fazla SPF kaydı var — tek kayıtta birleştirin."
    elif spf:
        st, msg = "warn", "SPF var ama bu sunucuyu (mx/ip4) içermiyor."
    else:
        st, msg = "fail", "SPF kaydı yok."
    add("spf", "SPF", st, spf, msg)

    dmarc = [t for t in dig("_dmarc." + dom, "TXT") if t.upper().startswith("V=DMARC1")]
    add("dmarc", "DMARC", "pass" if len(dmarc) == 1 else "fail", dmarc,
        "" if dmarc else "_dmarc TXT kaydı yok.")

    loc = dkim_local()
    dk = dig("%s._domainkey.%s" % (CONF["DKIM_SELECTOR"], dom), "TXT")
    dns_p = ""
    for t in dk:
        m = re.search(r"p=([A-Za-z0-9+/=]+)", t.replace(" ", ""))
        if m:
            dns_p = m.group(1)
    if not loc:
        st, msg = "fail", "Sunucuda DKIM anahtarı yok."
    elif dns_p and dns_p == loc["p"]:
        st, msg = "pass", ""
    elif dns_p:
        st, msg = "fail", "DNS'teki DKIM anahtarı sunucudakiyle eşleşmiyor."
    else:
        st, msg = "fail", "DKIM TXT kaydı yok."
    add("dkim", "DKIM (%s)" % CONF["DKIM_SELECTOR"], st, dk, msg)

    ptr = [p.rstrip(".").lower() for p in dig(ip, "PTR")] if ip else []
    add("ptr", "rDNS / PTR (%s)" % (ip or "?"), "pass" if host in ptr else "fail", ptr,
        "" if host in ptr else "SNET panelinden IP'nin rDNS kaydını %s yapın." % host)

    ok25, detail = port25_open()
    checks.append({"key": "port25", "label": "Giden 25 portu", "status": "pass" if ok25 else "fail",
                   "found": [detail], "expected": None,
                   "message": "" if ok25 else "Kapalıysa relay (Brevo/Resend) kullanın."})

    res = {"ok": True, "domain": dom, "host": host, "public_ip": ip, "checks": checks,
           "all_pass": all(c["status"] == "pass" for c in checks)}
    if args.json:
        return res
    for c in checks:
        print("[%s] %s %s" % (c["status"].upper(), c["label"], c["message"]))
    return None


