def cmd_backup(args):
    paths = [p for p in [CONF["VMAIL_HOME"], CONF["USERS_FILE"], CONF["VMAILBOX_FILE"], CONF["VIRTUAL_FILE"],
                         CONF["META_FILE"], "/etc/opendkim", "/etc/opendkim.conf", "/etc/dovecot/local.conf",
                         "/etc/postfix/main.cf", "/etc/postfix/master.cf", "/etc/postfix/sasl_passwd",
                         "/etc/postfix/sender_login_maps.pcre", CONF_FILE,
                         "/var/www/roundcube/config/config.inc.php", "/var/www/roundcube/db"]
             if os.path.exists(p)]
    os.makedirs(CONF["BACKUP_DIR"], mode=0o700, exist_ok=True)
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M")
    out = os.path.join(CONF["BACKUP_DIR"], "mail-%s.tar.gz" % stamp)
    run(["tar", "--warning=no-file-changed", "-czpf", out, "--absolute-names", "--"] + paths,
        timeout=3600)
    if not os.path.exists(out):
        raise CliError("Yedek oluşturulamadı")
    os.chmod(out, 0o600)
    keep = max(1, int(CONF["BACKUP_KEEP"] or 3))
    olds = sorted(f for f in os.listdir(CONF["BACKUP_DIR"]) if re.match(r"^mail-\d{8}-\d{4}\.tar\.gz$", f))
    for f in olds[:-keep]:
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(CONF["BACKUP_DIR"], f))
    res = {"ok": True, "file": out, "size": os.path.getsize(out), "paths": paths}
    if args.json:
        return res
    print("yedek: %s (%d bayt)" % (out, res["size"]))
    return None


