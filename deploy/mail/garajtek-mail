def build_parser():
    p = argparse.ArgumentParser(prog="garajtek-mail", description="GarajTek mail sunucusu yönetimi")
    sub = p.add_subparsers(dest="cmd", required=True)

    def sp(name, fn, help_text):
        s = sub.add_parser(name, help=help_text)
        s.add_argument("--json", action="store_true", help="JSON çıktı")
        s.set_defaults(fn=fn)
        return s

    def pw_opts(s):
        g = s.add_mutually_exclusive_group()
        g.add_argument("--password", help="şifre (argv'de görünür — tercihen --password-stdin)")
        g.add_argument("--password-stdin", action="store_true", help="şifreyi stdin'den (tek satır) oku")
        g.add_argument("--random", action="store_true", help="rastgele şifre üret ve bir kez göster")

    sp("list", cmd_list, "posta kutularını listele")
    s = sp("add", cmd_add, "posta kutusu ekle")
    s.add_argument("email")
    s.add_argument("--quota", default=None, help="ör. 1G, 500M, 0=sınırsız")
    pw_opts(s)
    s = sp("passwd", cmd_passwd, "şifre değiştir")
    s.add_argument("email")
    pw_opts(s)
    s = sp("quota", cmd_quota, "kota değiştir")
    s.add_argument("email")
    s.add_argument("size")
    s = sp("del", cmd_del, "posta kutusunu sil")
    s.add_argument("email")
    s.add_argument("--purge", action="store_true", help="posta dosyalarını da sil")
    sp("alias-list", cmd_alias_list, "yönlendirmeleri listele")
    s = sp("alias-add", cmd_alias_add, "yönlendirme ekle/güncelle")
    s.add_argument("source")
    s.add_argument("destination", help="hedef adres(ler), virgülle")
    s = sp("alias-del", cmd_alias_del, "yönlendirme sil")
    s.add_argument("source")
    sp("status", cmd_status, "servis durumu")
    sp("dns-check", cmd_dns_check, "DNS / teslim edilebilirlik kontrolü")
    sp("port25-check", cmd_port25, "giden 25 portu testi")
    sp("queue", cmd_queue, "posta kuyruğu")
    sp("queue-flush", cmd_queue_flush, "kuyruğu yeniden dene")
    s = sp("queue-delete", cmd_queue_delete, "kuyruktan mesaj sil (ID veya ALL)")
    s.add_argument("queue_id")
    s = sp("test-send", cmd_test_send, "test e-postası gönder")
    s.add_argument("to")
    sp("dkim-record", cmd_dkim_record, "DKIM DNS kaydını yazdır")
    sp("backup", cmd_backup, "posta verisini yedekle")
    return p


def main(argv=None):
    global CONF
    parser = build_parser()
    args = parser.parse_args(argv)
    want_json = bool(getattr(args, "json", False))
    try:
        if os.geteuid() != 0 and not os.environ.get("GARAJTEK_MAIL_ALLOW_NONROOT"):
            raise CliError("root olarak çalıştırın (sudo garajtek-mail ...)")
        CONF = load_conf()
        res = args.fn(args)
        if res is not None:
            if want_json:
                print(json.dumps(res, ensure_ascii=False))
            else:
                print(json.dumps(res, indent=2, ensure_ascii=False))
        return 0
    except CliError as e:
        if want_json:
            print(json.dumps({"ok": False, "error": str(e), "code": e.code}, ensure_ascii=False))
        else:
            print("HATA: " + str(e), file=sys.stderr)
        return e.code
    except Exception as e:  # beklenmeyen hata — iz bırakmadan JSON döndür
        if want_json:
            print(json.dumps({"ok": False, "error": "beklenmeyen hata: %s" % e.__class__.__name__,
                              "code": EXIT_ERR}, ensure_ascii=False))
            return EXIT_ERR
        raise


if __name__ == "__main__":
    sys.exit(main())
