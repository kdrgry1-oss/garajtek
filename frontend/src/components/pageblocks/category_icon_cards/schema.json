  "variants": [
    {
      "value": "v4",
      "label": "v2.0 home-v4 – Gri bantta beyaz kartlar (5'li)",
      "defaults_patch": {}
    },
    {
      "value": "v5",
      "label": "v2.0 home-v5 – Büyük gri kartlar (3'lü)",
      "defaults_patch": {
        "header": {
          "title": ""
        },
        "columns": {
          "desktop": 3,
          "tablet": 2,
          "mobile": 1
        },
        "image_size": 148,
        "tile_background": "#f5f5f5",
        "label_size": ""
      }
    },
    {
      "value": "v8",
      "label": "v2.0 home-v8 – Solda büyük banner + gri kartlar",
      "defaults_patch": {
        "header": {
          "title": ""
        },
        "columns": {
          "desktop": 3,
          "tablet": 3,
          "mobile": 1
        },
        "lead_banner": {
          "enabled": true
        },
        "tile_background": "#f5f5f5",
        "min_height": 120,
        "label_size": "14"
      }
    }
  ],
  "tabs": [
    "İçerik",
    "Ürünler",
    "Görünüm",
    "Karusel",
    "Gelişmiş"
  ],
  "fields": [
    {
      "name": "header",
      "type": "section_header",
      "label": "Başlık satırı",
      "tab": "İçerik",
      "help": "Başlık boşsa başlık satırı gizlenir.",
      "right_options": [
        "none",
        "pills",
        "link"
      ]
    },
    {
      "name": "tiles",
      "type": "repeater",
      "label": "Kartlar",
      "tab": "İçerik",
      "item_fields": [
        {
          "name": "image",
          "type": "image",
          "label": "Görsel",
          "tab": "İçerik",
          "recommended": [
            300,
            300
          ],
          "help": "Şeffaf PNG önerilir; karta 15° döndürülmüş yerleşir."
        },
        {
          "name": "label",
          "type": "text",
          "label": "Ad",
          "tab": "İçerik",
          "max_length": 80
        },
        {
          "name": "link",
          "type": "link",
          "label": "Bağlantı",
          "tab": "İçerik",
          "kinds": [
            "category",
            "product",
            "page",
            "brand",
            "search",
            "url",
            "none"
          ]
        }
      ],
      "item_default": {
        "image": null,
        "label": "",
        "link": {
          "kind": "none",
          "url": "",
          "new_tab": false
        }
      },
      "max": 12,
      "item_label": "{{label}}",
      "item_noun": "Kart"
    },
    {
      "name": "lead_banner",
      "type": "group",
      "label": "Öndeki büyük banner (v2.0 home-v8)",
      "tab": "İçerik",
      "fields": [
        {
          "name": "enabled",
          "type": "bool",
          "label": "Göster",
          "tab": "İçerik"
        },
        {
          "name": "image",
          "type": "image",
          "label": "Arka plan görseli",
          "tab": "İçerik",
          "recommended": [
            543,
            272
          ],
          "show_if": {
            "enabled": [
              true
            ]
          }
        },
        {
          "name": "label",
          "type": "text",
          "label": "Yazı",
          "tab": "İçerik",
          "show_if": {
            "enabled": [
              true
            ]
          },
          "max_length": 80
        },
        {
          "name": "link",
          "type": "link",
          "label": "Bağlantı",
          "tab": "İçerik",
          "kinds": [
            "category",
            "product",
            "page",
            "brand",
            "search",
            "url",
            "none"
          ],
          "show_if": {
            "enabled": [
              true
            ]
          }
        }
      ]
    },
    {
      "name": "columns",
      "type": "number",
      "label": "Satırdaki kart sayısı",
      "tab": "Görünüm",
      "unit": "adet",
      "min": 1,
      "max": 6,
      "responsive": true,
      "help": "Masaüstü (≥1200 px) / tablet (768–1199 px) / mobil. 992–1199 px arasında şablondaki gibi masaüstünden bir eksik (tabletten az olmamak üzere) gösterilir. Mobilde kartlar yana kaydırılabilir şerit olur (aşağıdaki ayar)."
    },
    {
      "name": "mobile_scroll",
      "type": "bool",
      "label": "Mobilde yana kaydırılabilir şerit",
      "tab": "Görünüm",
      "width": "half"
    },
    {
      "name": "rotation",
      "type": "number",
      "label": "Görsel dönüş açısı (derece)",
      "tab": "Görünüm",
      "min": -45,
      "max": 45,
      "width": "half"
    },
    {
      "name": "image_size",
      "type": "number",
      "label": "Görsel genişliği",
      "tab": "Görünüm",
      "unit": "px",
      "min": 40,
      "max": 200,
      "width": "half"
