  "category": "kategori",
  "group": "D",
  "status": "ready",
  "template_refs": [
    "T2/html/home/home-v4.html#Top Categories this Week",
    "T2/html/home/home-v5.html#Categories Card",
    "T2/html/home/home-v8.html#Banner"
  ],
  "layout": "container",
  "singleton": false,
  "allowed_pages": [
    "home",
    "*"
