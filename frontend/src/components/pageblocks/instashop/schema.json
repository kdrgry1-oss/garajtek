{
  "key": "instashop",
  "version": 2,
  "title": "Atölyemizden (görsel ızgara)",
  "description": "Instagram tarzı kare görsel karuseli + 'Takip Edin' bağlantısı",
  "category": "icerik",
  "group": "A",
  "status": "ready",
  "template_refs": [],
  "layout": "container",
  "singleton": false,
  "allowed_pages": [
    "home",
    "*"
  ],
  "variants": [],
  "tabs": [
    "İçerik",
    "Ürünler",
    "Görünüm",
    "Karusel",
    "Gelişmiş"
  ],
  "fields": [
    {
      "name": "title",
      "type": "text",
      "label": "Başlık",
      "tab": "İçerik"
    },
    {
      "name": "show_follow",
      "type": "bool",
      "label": "“Takip Edin” bağlantısını göster",
      "tab": "İçerik",
      "width": "half",
      "help": "Bağlantı adresi Mağaza Bilgileri › Instagram alanından gelir."
    },
    {
      "name": "follow_text",
      "type": "text",
      "label": "Takip bağlantısı yazısı",
      "tab": "İçerik",
      "width": "half",
      "show_if": {
        "show_follow": [
          true
        ]
      }
    },
    {
      "name": "items",
      "type": "repeater",
      "label": "Görseller",
      "tab": "İçerik",
      "max": 12,
      "item_label": "{{alt}}",
      "item_noun": "Görsel",
      "item_fields": [
        {
          "name": "image",
          "type": "image",
          "label": "Görsel",
          "recommended": [
            600,
            600
          ]
        },
        {
          "name": "link",
          "type": "link",
          "label": "Bağlantı",
          "kinds": [
            "category",
            "product",
            "page",
            "brand",
            "search",
            "url",
            "none"
          ]
        },
        {
          "name": "alt",
          "type": "text",
          "label": "Alternatif metin"
        }
      ],
      "item_default": {
        "image": null,
        "link": {
          "kind": "url",
          "url": "",
          "new_tab": false
        },
        "alt": ""
      }
    },
    {
      "name": "columns",
      "type": "select",
      "label": "Masaüstü sütun",
      "tab": "Görünüm",
      "width": "half",
      "options": [
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "6",
          "label": "6"
        }
      ]
    },
    {
      "name": "radius",
      "type": "number",
      "label": "Köşe yuvarlaklığı",
      "tab": "Görünüm",
      "unit": "px",
      "min": 0,
      "max": 40,
      "width": "half"
    },
    {
      "name": "carousel",
      "type": "carousel",
      "label": "Karusel",
      "tab": "Karusel",
      "hide": [
        "rows",
        "transition",
        "last_active_divider"
      ],
      "help": "Masaüstü (≥1200) sütun sayısı yukarıdaki 'Masaüstü sütun' alanından gelir."
    }
  ],
  "common": [
    "section",
    "visibility",
    "reveal"
  ]
}
