  "variants": [
    {
      "value": "recommendations",
      "label": "Size özel öneriler (6 sütun)",
      "defaults_patch": {
        "pagination": false,
        "card": "grid",
        "columns": {
          "desktop": 6,
          "tablet": 4,
          "mobile": 2
        },
        "header": {
          "right": "link"
        }
      }
    },
    {
      "value": "recently_viewed",
      "label": "Son bakılan ürünler (yalnız görsel)",
      "defaults_patch": {
        "header": {
          "title": "Son Baktığınız Ürünler",
          "right": "none"
        },
        "source": {
          "kind": "recently_viewed",
          "product_ids": [],
          "category_ids": [],
          "include_children": true,
          "tag": "",
          "brand_ids": [],
          "limit": 8,
          "sort": "default",
          "exclude_out_of_stock": false,
          "exclude_ids": [],
          "fill_with": "none"
        },
        "card": "image_only",
        "columns": {
          "desktop": 8,
          "tablet": 4,
          "mobile": 3
        },
        "empty_text": "",
        "pagination": false
      }
    },
    {
      "value": "hot",
      "label": "Bugünün popüler ürünleri (sayfalı ızgara, v2.0 home-v10)",
      "defaults_patch": {
        "header": {
          "title": "Bugünün Popüler Ürünleri",
          "right": "none"
        },
        "source": {
          "kind": "best_sellers",
          "product_ids": [],
          "category_ids": [],
          "include_children": true,
          "tag": "",
          "brand_ids": [],
          "limit": 36,
          "sort": "default",
          "exclude_out_of_stock": false,
          "exclude_ids": [],
          "fill_with": "none"
        },
        "card": "grid",
        "columns": {
          "desktop": 4,
          "tablet": 3,
          "mobile": 2
        },
        "pagination": true,
        "page_size": 12
      }
    }
  ],
  "tabs": [
    "İçerik",
    "Ürünler",
    "Görünüm",
    "Gelişmiş"
  ],
  "fields": [
    {
      "name": "header",
      "type": "section_header",
      "label": "Başlık satırı",
      "tab": "İçerik",
      "help": "Sağda “Tümünü gör” bağlantısı ya da hap sekmeler (sekme haplar kendi ürün kaynağını gösterir).",
      "right_options": [
        "none",
        "pills",
        "link"
      ]
    },
    {
      "name": "source",
      "type": "product_source",
      "label": "Ürün kaynağı",
      "tab": "Ürünler",
      "allowed_kinds": [
        "manual",
        "category",
        "discounted",
        "newest",
        "best_sellers",
        "featured",
        "top_rated",
        "tag",
        "brand",
        "recently_viewed"
      ],
      "default_limit": 12
    },
    {
      "name": "columns",
      "type": "number",
      "label": "Sütun sayısı",
      "tab": "Görünüm",
      "responsive": true,
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "adet",
      "help": "Cihaz başına sütun sayısı. Şablondaki gibi masaüstünde 6 ve üzeri sütunda 1200–1479 px arası ekranlarda bir sütun eksik gösterilir (yarım kalan satır gizlenir); 1480 px ve üzeri tam sayı."
    },
    {
      "name": "card",
      "type": "select",
      "label": "Kart tipi",
      "tab": "Görünüm",
      "options": [
        {
          "value": "grid",
          "label": "Izgara kartı"
        },
        {
          "value": "image_only",
          "label": "Yalnız görsel"
        },
        {
          "value": "horizontal",
          "label": "Yatay kart"
        }
      ]
    },
    {
      "name": "pagination",
      "type": "bool",
      "label": "Sayfalama",
      "tab": "Görünüm",
      "width": "half"
    },
    {
      "name": "page_size",
      "type": "number",
      "label": "Sayfa başına ürün",
      "tab": "Görünüm",
      "width": "half",
      "min": 1,
      "max": 48,
      "unit": "adet",
      "show_if": {
        "pagination": [
          true
        ]
      }
    },
    {
      "name": "show_more_button",
      "type": "group",
      "label": "“Daha Fazla Göster” düğmesi",
      "tab": "Görünüm",
      "show_if": {
        "pagination": [
          false
        ]
      },
      "fields": [
        {
          "name": "enabled",
          "type": "bool",
          "label": "Açık",
          "width": "half"
        },
        {
          "name": "text",
          "type": "text",
          "label": "Düğme yazısı",
          "width": "half"
        },
        {
          "name": "initial",
          "type": "number",
          "label": "İlk gösterilen",
          "min": 1,
          "max": 48,
          "unit": "adet",
          "width": "half"
        },
        {
          "name": "step",
          "type": "number",
          "label": "Her tıklamada eklenen",
          "min": 1,
          "max": 48,
          "unit": "adet",
          "width": "half"
        }
      ]
    },
    {
      "name": "empty_text",
      "type": "text",
      "label": "Ürün yoksa gösterilecek yazı",
      "tab": "Gelişmiş",
      "help": "Boşsa ürün yokken bölüm gizlenir."
    }
  ],
  "common": [
    "section",
    "visibility",
    "reveal"
  ]
}
