{
  "key": "product_grid",
  "version": 2,
  "title": "Ürün Izgarası",
  "description": "Başlık + “Tümünü gör” bağlantılı çok sütunlu ürün ızgarası; sayfalama veya “Daha Fazla Göster” (v2.0 home-v7 Recommendation For You, home-v10 Hot Products, home-v9 son bakılanlar)",
  "category": "urun",
  "group": "B",
  "status": "ready",
  "template_refs": [
    "T2/html/home/home-v7.html#Recommendation-For-You",
    "T2/html/home/home-v10.html#Hot-Products-Today",
    "T2/html/home/home-v9.html#Recently-Viewed"
  ],
  "layout": "container",
  "singleton": false,
  "allowed_pages": [
    "home",
    "*"
